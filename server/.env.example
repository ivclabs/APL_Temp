# Copy to .env and set your own values. .env is never pushed to GitHub.
# Make a random key with:  python3 -c "import secrets; print(secrets.token_hex(16))"
API_KEY=change-me

# Alarm limits (optional - these are the defaults)
ALARM_HIGH_C=28
ALARM_LOW_C=15
ALARM_RISE_C_PER_MIN=1.0
ALARM_COOLDOWN_MIN=15

# ESP32 sends at least this often (seconds), sooner if the temperature changes.
# Used by the web page countdown. Must match HEARTBEAT_MS on the ESP32.
READING_EVERY_S=30

# AI (Claude Haiku 4.5 on Bedrock). AI_BACKEND: bedrock (AWS, uses the IAM role), anthropic (needs
# ANTHROPIC_API_KEY), or off. AI_DAILY_LIMIT caps the number of AI calls per day (cost guard).
AI_BACKEND=bedrock
AWS_REGION=eu-north-1
AI_DAILY_LIMIT=50
